        },
        "required": [
          "operation",
          "params"
        ],
        "title": "DownscaleOperation",
        "type": "object"
      },
      "EditRequest": {
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "discriminator": {
                "mapping": {
                  "clip": "#/components/schemas/ClipOperation",
                  "convert": "#/components/schemas/ConvertOperation",
                  "crop": "#/components/schemas/CropOperation",
                  "downscale": "#/components/schemas/DownscaleOperation",
                  "upscale": "#/components/schemas/UpscaleOperation"
