            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 104857600.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "request_id",
          "filename",
          "content_type",
          "size_bytes",
          "sha256"
        ],
        "title": "ReserveRequest",
        "type": "object"
