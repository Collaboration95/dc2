            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "ClipOperation": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "clip",
            "title": "Operation",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/ClipParams"
          }
        },
        "required": [
          "operation",
          "params"
        ],
        "title": "ClipOperation",
        "type": "object"
      },
      "ClipParams": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "title": "End"
          },
          "start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Start"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "ClipParams",
        "type": "object"
      },
      "ConvertOperation": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "convert",
            "title": "Operation",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/ConvertParams"
          }
        },
        "required": [
          "operation",
          "params"
        ],
        "title": "ConvertOperation",
        "type": "object"
      },
      "ConvertParams": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "mkv",
              "mp3"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "format"
        ],
        "title": "ConvertParams",
        "type": "object"
      },
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CropOperation": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "crop",
            "title": "Operation",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/CropParams"
          }
        },
        "required": [
          "operation",
          "params"
        ],
        "title": "CropOperation",
        "type": "object"
      },
      "CropParams": {
        "additionalProperties": false,
        "properties": {
          "h": {
            "exclusiveMinimum": 0.0,
            "title": "H",
            "type": "integer"
          },
          "w": {
            "exclusiveMinimum": 0.0,
            "title": "W",
            "type": "integer"
          },
          "x": {
            "minimum": 0.0,
            "title": "X",
            "type": "integer"
          },
          "y": {
            "minimum": 0.0,
            "title": "Y",
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "title": "CropParams",
        "type": "object"
      },
