                {
                  "$ref": "#/components/schemas/ClipOperation"
                },
                {
                  "$ref": "#/components/schemas/CropOperation"
                },
                {
                  "$ref": "#/components/schemas/DownscaleOperation"
                },
                {
                  "$ref": "#/components/schemas/UpscaleOperation"
                },
                {
                  "$ref": "#/components/schemas/ConvertOperation"
                }
              ]
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Operations",
            "type": "array"
          }
        },
        "required": [
          "operations"
        ],
        "title": "EditRequest",
        "type": "object"
      },
      "FinalizeRequest": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "FinalizeRequest",
        "type": "object"
      },
