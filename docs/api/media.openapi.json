            "title": "Status",
            "type": "string"
          },
          "submission_status": {
            "enum": [
              "pending",
              "submitted",
              "error"
            ],
            "title": "Submission Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "status",
          "submission_status"
        ],
        "title": "PublicJob",
        "type": "object"
      },
      "ReserveRequest": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
