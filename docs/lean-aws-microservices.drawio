        <mxCell id="media-s3-label" value="sources + authorised reads" vertex="1" connectable="0" parent="media-s3" style="fontFamily=Helvetica;edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;labelBackgroundColor=none;fontColor=light-dark(#232F3E,#FAFAFA);">
          <mxGeometry x="0" y="-16" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="viewer-s3" edge="1" parent="1" source="users" target="s3" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=light-dark(#52616B,#BAC8D3);strokeWidth=1.7;exitX=0.5;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="1210" />
              <mxPoint x="1520" y="1210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="viewer-s3-label" value="signed output HTTPS · internet egress" vertex="1" connectable="0" parent="viewer-s3" style="fontFamily=Helvetica;edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;labelBackgroundColor=none;fontColor=light-dark(#232F3E,#FAFAFA);">
          <mxGeometry x="0" y="-16" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="" style="fontFamily=Helvetica;rounded=1;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1710" y="30" width="520" height="1200" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-1" value="1" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="65" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1" value="&lt;b&gt;Public access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;CloudFront generates the URL and viewer TLS certificate. No domain purchase or client installation.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="65" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="222" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2" value="&lt;b&gt;Small shared state host&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;PostgreSQL has two databases and distinct roles. Redis belongs to Processing. nginx routes to Media. This host remains a shared failure point.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="222" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="379" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3" value="&lt;b&gt;Independent application compute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;Media and Processing have separate Fargate services, image digests, migrations and releases. No FFmpeg runs on the state host.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="379" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="536" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4" value="&lt;b&gt;Recovery and task starts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;A separate Processing recovery task repairs the ledger/queue. Batch starts are explicit. An unattended starter is optional and not implemented.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="536" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="693" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5" value="&lt;b&gt;Disposable worker capacity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;Burst workers exit after the queue drains. Target one; explicitly select two or three for tests. On-demand first, Spot optional.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="693" width="425" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="fontFamily=Helvetica;rounded=1;html=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=#007CBD;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1">
          <mxGeometry x="1730" y="850" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6" value="&lt;b&gt;Private object traffic&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#232F3E,#FAFAFA)&quot;&gt;Free S3 gateway route for same-region object calls. External signed playback is still billed transfer. S3 is a regional service, not in the subnet.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1785" y="850" width="425" height="130" as="geometry" />
        </mxCell>
