        <mxCell id="legend-warning" value="&lt;b&gt;Reviewable tradeoffs&lt;/b&gt;&lt;br&gt;CloudFront → origin uses restricted HTTP.&lt;br&gt;No claim of end-to-end TLS or high availability.&lt;br&gt;Stop the site between sessions; release public IP.&lt;br&gt;&lt;br&gt;&lt;b&gt;14-day planning allowance&lt;/b&gt;&lt;br&gt;$13.03 expected / $28.27 conservative&lt;br&gt;Includes reserves; no credits or Spot savings." style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=light-dark(#232F3E,#F5F5F5);fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1730" y="1030" width="475" height="180" as="geometry" />
        </mxCell>
      </root>
