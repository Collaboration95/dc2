.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
processing-coverage.xml
htmlcov/
frontend/coverage/
.scannerwork/
zap-reports/
.mypy_cache/

# Credentials and keys. Never commit these -- a key in a public repo is
# compromised the moment it is pushed, whether or not anyone notices.
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.ppk

# Let's Encrypt state. conf/ holds private keys; www/ is transient challenge
# files. The directories are created on demand -- see docs/sprint2-plan.md S2-05.
deploy/certbot/

# Deployment TLS server block. The directory is tracked, its contents are not:
# hostnames and certificate paths are deployment-specific. See the README.
deploy/nginx-tls/*
!deploy/nginx-tls/README.md

# Local-only orchestration notes -- not part of the team's shared repo.
multitasking.md

# Design-canvas mockup source (Claude Design .dc.html components) used to
# draft the frontend redesign. Reference material, not code the app ships --
# the real implementation lives in frontend/.
frontend-redesign/

# Project-local agent workspaces and reproducible runtime/evidence scratch.
.worktrees/
.cache/
.local/
artifacts/
