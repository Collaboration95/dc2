server {
    listen 443 ssl;
    server_name localhost;
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    root /usr/share/nginx/html;
    location = /health { default_type application/json; return 200 '{"status":"ok","stage":"infrastructure"}'; }
    # Media integration replaces this with its upstream; no public workflow exists yet.
    location /api { return 503; }
    location /internal/ { return 404; }
    location / { try_files $uri $uri/ =404; }
    location /minio/health/ { proxy_pass http://minio:9000; }
    # Preserve raw bucket paths, query signatures and the signed host INCLUDING port.
    location /${DC2_SOURCE_BUCKET}/ {
        access_log off; # Presigned query strings are bearer capabilities.
        proxy_set_header Host $http_host;
        proxy_pass http://minio:9000;
        proxy_request_buffering off;
        client_max_body_size 0;
    }
    location /${DC2_OUTPUT_BUCKET}/ {
        access_log off;
        proxy_set_header Host $http_host;
        proxy_pass http://minio:9000;
        proxy_request_buffering off;
        client_max_body_size 0;
    }
}

# Container liveness stays private; host/container storage smoke verifies TLS.
server {
    listen 127.0.0.1:8080;
    location = /health { return 200 "ok"; }
}
