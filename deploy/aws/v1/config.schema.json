{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DC2 V1 nonsecret render inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "account_id",
    "region",
    "source_cors_origin",
    "deploy_applications",
    "parameter_arns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,23}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "const": "ap-southeast-1"
    },
    "source_cors_origin": {
      "type": "string",
      "pattern": "^https://[a-zA-Z0-9.-]+$"
    },
    "deploy_applications": {
      "type": "boolean"
    },
    "aurora_engine_version": {
      "type": "string",
      "pattern": "^16\\.(?:[3-9]|[1-9][0-9])$"
    },
    "worker_lifetime_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "parameter_arns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_runtime_dsn",
        "processing_runtime_dsn",
        "media_migration_dsn",
        "processing_migration_dsn",
        "jwt_secret"
      ],
      "properties": {
        "media_runtime_dsn": {
          "type": "string",
          "pattern": "^arn:aws:ssm:ap-southeast-1:[0-9]{12}:parameter/dc2/[A-Za-z0-9_/.-]+$"
        },
        "processing_runtime_dsn": {
          "type": "string",
          "pattern": "^arn:aws:ssm:ap-southeast-1:[0-9]{12}:parameter/dc2/[A-Za-z0-9_/.-]+$"
        },
        "media_migration_dsn": {
          "type": "string",
          "pattern": "^arn:aws:ssm:ap-southeast-1:[0-9]{12}:parameter/dc2/[A-Za-z0-9_/.-]+$"
        },
        "processing_migration_dsn": {
          "type": "string",
          "pattern": "^arn:aws:ssm:ap-southeast-1:[0-9]{12}:parameter/dc2/[A-Za-z0-9_/.-]+$"
        },
        "jwt_secret": {
          "type": "string",
          "pattern": "^arn:aws:ssm:ap-southeast-1:[0-9]{12}:parameter/dc2/[A-Za-z0-9_/.-]+$"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "string",
          "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-southeast-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}$"
        },
        "processing": {
          "type": "string",
          "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-southeast-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}$"
        },
        "worker": {
          "type": "string",
          "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-southeast-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "handlers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*\\.[A-Za-z_][A-Za-z0-9_]*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deploy_applications": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "images"
        ],
        "properties": {
          "images": {
            "required": [
              "media",
              "processing",
              "worker"
            ]
          }
        }
      }
    }
  ]
}
