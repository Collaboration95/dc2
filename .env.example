# Copy this file to .env for local development. Do not commit .env.
#
# PORT POLICY
# -----------
# nginx (the `frontend` service) is the only service published beyond loopback.
# Everything else -- the API, MinIO's S3 API and console, PostgreSQL, Redis --
# is pinned to 127.0.0.1 in docker-compose.yml and is NOT configurable, because
# the app has no authentication of its own yet (P1 in docs/sprint2-backlog.md).
# Reach an internal service from your machine with a tunnel rather than a port:
#
#   ssh -L 5432:127.0.0.1:5432 root@<host>    # then psql to localhost:5432
#   ssh -L 9001:127.0.0.1:9001 root@<host>    # then MinIO console on :9001
#
# A deployment that anyone else can reach sets FRONTEND_BIND=0.0.0.0 and
# FRONTEND_PORT=80, and MUST put an access gate in deploy/auth first.
# Signing secret for the session cookie. Required -- there is no default,
# and the API refuses to issue or accept a token without it.
#   openssl rand -base64 48
JWT_SECRET=change-me-this-is-not-a-real-secret-generate-your-own
JWT_TTL_SECONDS=1800

API_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

REDIS_PORT=6379
REDIS_PUBLIC_PORT=6379
# Redis requires a password. This dev default is shared by the redis container
# and both clients; anything not on your own machine needs a real secret here.
REDIS_PASSWORD=flickpond_dev_redis_password
# REDIS_HOST=your-redis.example.com
# REDIS_PORT=6380
# REDIS_SSL=true

POSTGRES_DB=flickpond
POSTGRES_USER=flickpond
POSTGRES_PASSWORD=flickpond_dev_password
POSTGRES_PORT=5432
# POSTGRES_DSN=postgresql://user:password@your-postgres.example.com:5432/flickpond?sslmode=require

# Dev credentials for the local MinIO container. Compose binds MinIO to
# 127.0.0.1 only, which is the reason these are tolerable; change them before
# publishing the MinIO ports anywhere beyond your own machine.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# MINIO_ENDPOINT=s3.example.com
# MINIO_PUBLIC_ENDPOINT=media.example.com
# MINIO_USE_SSL=true
# MINIO_BUCKET=videos
# MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY=replace-with-a-key
# MINIO_SECRET_KEY=replace-with-a-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_REGION=us-east-1
