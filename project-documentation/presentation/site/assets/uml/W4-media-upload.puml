!include _style.iuml
title Physical data view · Media upload pins · 76282d3
hide circle
skinparam linetype polyline
left to right direction
skinparam defaultFontSize 19
skinparam ClassAttributeFontSize 18
skinparam ClassFontSize 20
skinparam ArrowFontSize 16
skinparam LegendFontSize 14
skinparam nodesep 42
skinparam ranksep 70
entity "upload_reservations" as upload_reservations $MEDIA {
  {field} * id : uuid <<PK>>
  {field} * owner_id : uuid <<FK,UK3>>
  {field} * request_id : uuid <<UK3>>
  {field} * request_hash : varchar(64)
  {field} * asset_id : uuid <<UK>>
  {field} * filename : varchar(100)
  {field} * bucket : text
  {field} * key : text <<UK>>
  {field} * content_type : varchar(100)
  {field} * size_bytes : integer
  {field} * sha256 : varchar(64)
  {field}   version_id ? : text
  {field} * expires_at : timestamptz
  {field}   finalized_at ? : timestamptz
  {field} * created_at : timestamptz
  {field} * cleanup_checked_at : timestamptz
  {field} * cleanup_next_at : timestamptz
  {field} * cleanup_attempts : integer
  {field}   cleanup_retired_at ? : timestamptz
  --
  UK3 = (owner_id, request_id)
}
entity "users\n<<reference: key only>>" as users $INFRA {
  {field} * id : uuid <<PK>>
}
users ||--o{ upload_reservations : "owner_id"

legend bottom left
  * = NOT NULL    ? = nullable    PK = primary key    FK = declared local foreign key
  UK = unique column    UKn = one composite unique group    timestamptz = timestamp with time zone
  Blue = Media; amber = Processing; grey = reference key on another sheet
  All columns of coloured tables are shown; CHECKs, defaults and indexes are in the report dictionary.
endlegend
