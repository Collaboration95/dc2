[-> E : edit(s,storage,owner,parent_id,request,key)
activate E
ref over E,DB : Preflight checks; then intake.stage(s,k) commits the ledger
 group Copy transaction: parent + staged locks
 E -> S : copy_output_source(output,k)
 activate S
 S --> E : size,sha256
 deactivate S
 E -> DB : SQL: write_uncertain=False; COMMIT
end
group Adoption transaction: staged lock
 E -> DB : SQL: check staged row; add/flush derived Asset
 E -> E : pin_copied_source(s,storage,asset)
 E -> E : stage_submit(s,asset,pin)
 E -> DB : COMMIT Asset + pin + optional RequestKey +\nsubmit outbox; remove staged ledger
end
[<-- E : asset: Asset -> HTTP 202 at API caller
 deactivate E
ref over E,DB : Independent repair after adoption commit: publish_commands -> publish_due -> SQS.send (W3-14a)
legend bottom
Blue = Media; slate = SQL. Independent relay may precede HTTP 202. Detail: W3-14a/b.
endlegend

