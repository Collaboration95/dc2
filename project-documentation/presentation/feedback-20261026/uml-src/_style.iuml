' Shared look for every FlickPond UML figure. Include with:
'   !include _style.iuml
' Colours match the deck: Media blue, Processing amber, clients green,
' shared/infrastructure slate.
!$MEDIA = "#DBEAFE"
!$MEDIA_LINE = "#2563EB"
!$PROC = "#FEF3C7"
!$PROC_LINE = "#D97706"
!$CLIENT = "#ECFDF5"
!$CLIENT_LINE = "#059669"
!$INFRA = "#F1F5F9"
!$INFRA_LINE = "#64748B"

skinparam dpi 110
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam defaultFontColor #0f172a
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam ArrowColor #475569
skinparam ArrowThickness 1.4
skinparam ArrowFontSize 13
skinparam ArrowFontColor #334155
skinparam BackgroundColor transparent
skinparam LegendBackgroundColor #ffffff
skinparam LegendBorderColor #94a3b8
skinparam LegendFontSize 13
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #d6c27a
skinparam NoteFontSize 13
skinparam PackageBorderColor #64748B
skinparam PackageBackgroundColor #ffffff
skinparam PackageFontStyle bold
skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #F1F5F9
skinparam ClassAttributeFontSize 13
skinparam ClassStereotypeFontSize 12
skinparam ComponentBackgroundColor #ffffff
skinparam ComponentBorderColor #334155
skinparam NodeBackgroundColor #ffffff
skinparam NodeBorderColor #334155
skinparam DatabaseBackgroundColor #ffffff
skinparam QueueBackgroundColor #ffffff
skinparam ParticipantBackgroundColor #ffffff
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #94a3b8
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceBoxBorderColor #94a3b8
skinparam SequenceMessageAlign left
skinparam ActivityBackgroundColor #ffffff
skinparam ActivityBorderColor #334155
skinparam ActivityDiamondBackgroundColor #F1F5F9
skinparam StateBackgroundColor #ffffff
skinparam StateBorderColor #334155
skinparam EntityBackgroundColor #ffffff
skinparam EntityBorderColor #334155
hide empty members
