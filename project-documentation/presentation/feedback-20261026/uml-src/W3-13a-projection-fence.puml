participant "projections\n«Media module»" as P $MEDIA
participant "s: AsyncSession" as DB $INFRA
[-> P : apply_result(s,body) [consume_result callback]
activate P
P -> DB : SQL: lock owned Asset; read accepted source + projection
P -> P : validate_transition(current,event)
alt older version OR newer version with older attempt number
 [<-- P : False
else same version + identical semantic hash
 [<-- P : False
else same version + conflicting semantic hash
