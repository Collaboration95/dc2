!include _style.iuml
@startuml
!include _style.iuml
title Physical data view · media_db · media_0008 · 76282d3
hide circle
skinparam linetype polyline
left to right direction
skinparam defaultFontSize 19
skinparam ClassAttributeFontSize 18
skinparam ClassFontSize 20
skinparam ArrowFontSize 16
skinparam LegendFontSize 14
skinparam nodesep 20
skinparam ranksep 45
entity "users" as users $MEDIA {
  {field} * id : uuid <<PK>>
  {field} * email : varchar(320) <<UK>>
}
entity "assets" as assets $MEDIA {
  {field} * id : uuid <<PK>>
  {field} * owner_id : uuid <<FK>>
  {field} * source_key : text <<UK>>
  {field} * operations : jsonb
}
entity "upload_reservations" as upload_reservations $MEDIA {
  {field} * id : uuid <<PK>>
  {field} * owner_id : uuid <<FK,UK3>>
  {field} * request_id : uuid <<UK3>>
  {field} * asset_id : uuid <<UK>>
  {field}   version_id ? : text
  {field}   finalized_at ? : timestamptz
  --
  UK3 = (owner_id, request_id)
}
entity "asset_source_versions" as asset_source_versions $MEDIA {
  {field} * asset_id : uuid <<PK,FK>>
  {field} * key : text
  {field} * version_id : text
}
entity "processing_projections" as processing_projections $MEDIA {
  {field} * asset_id : uuid <<PK,FK>>
  {field} * job_id : uuid <<UK>>
  {field} * state_version : integer
  {field} * status : varchar(20)
  {field} * outputs : jsonb
}
assets ||--o| processing_projections : "asset_id"
assets ||--o| asset_source_versions : "asset_id"
users ||--o{ upload_reservations : "owner_id"
users ||--o{ assets : "owner_id"
upload_reservations -[hidden]down- assets
legend bottom left
  * = NOT NULL    ? = nullable    PK = primary key    FK = declared local foreign key
  UK = unique column    UKn = one composite unique group    timestamptz = timestamp with time zone
  Blue = Media; amber = Processing. Only declared SQL foreign keys are connected.
  Key columns selected; full columns and checks are in backup/report
endlegend
@enduml
