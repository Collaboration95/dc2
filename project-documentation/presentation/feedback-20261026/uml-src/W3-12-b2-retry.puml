skinparam ArrowFontSize 17
skinparam defaultFontSize 18
skinparam NoteFontSize 17
skinparam LegendFontSize 17
participant "v1_lifecycle\n«Media module»" as M $MEDIA
participant "projections\n«Media module»" as P $MEDIA
participant "s: AsyncSession" as DB $INFRA
[-> M : retry(s,owner,asset_id,key)
activate M
group Media retry transaction
 M -> DB : SQL: lock owned Asset; request-key replay lookup
 alt matching key replay
  note over M,DB : prior Asset selected; no new command
 else no replay (failed projection required)
  M -> P : source_for_asset(s,asset)
  activate P
  P --> M : pin: dict
  deactivate P
  M -> M : command(s,asset,"retry",\nmessage_id=stable_uuid5,source=pin)
  M -> DB : SQL: optional RequestKey + retry outbox
 end
 M -> DB : COMMIT
end
[<-- M : asset: Asset
 deactivate M
ref over M,DB : Later MediaRepair -> SQS -> Processing successor transaction (W3-12a)
legend bottom
Caller api.v1_jobs.retry returns HTTP 202; nonfailed projection raises 409. Retry uses stored source.
endlegend

@enduml
