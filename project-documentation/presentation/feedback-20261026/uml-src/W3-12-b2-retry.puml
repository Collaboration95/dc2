@startuml
!include _style.iuml
skinparam dpi 96
skinparam defaultFontSize 16
skinparam ArrowFontSize 15
skinparam ClassAttributeFontSize 15
skinparam NoteFontSize 15
skinparam LegendFontSize 14
hide footbox
autonumber
skinparam sequenceMessageAlign left
skinparam maxMessageSize 400
skinparam sequenceMessageSpan true
skinparam sequence {
  MessageSpacing 2
  GroupBorderThickness 1
}
title Sequence view · UC-4 stages Media retry intent · 76282d3
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/media/api/v1_jobs.py#L49
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/media/services/v1_lifecycle.py#L50
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/media/handlers.py#L70
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/processing/messaging.py#L232
