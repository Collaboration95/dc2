skinparam ClassAttributeFontSize 15
skinparam NoteFontSize 15
skinparam LegendFontSize 14
hide footbox
autonumber
skinparam sequenceMessageAlign left
skinparam maxMessageSize 400
skinparam sequenceMessageSpan true
skinparam sequence {
  MessageSpacing 2
  GroupBorderThickness 1
}
title Sequence view · UC-3 commits a Media result projection · 76282d3
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/processing/recovery_v1.py#L166
' Evidence: https://github.com/Collaboration95/dc2/blob/76282d3/media/messaging.py#L16
