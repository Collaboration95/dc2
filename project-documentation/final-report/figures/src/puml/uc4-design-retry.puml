@startuml
!include _style.iuml
' Adapted from reviewed presentation sources: W3-10/11/12/12a/13/13a; retry identity and independent stale fences
skinparam dpi 110
skinparam defaultFontSize 18
skinparam ArrowFontSize 17
skinparam ClassAttributeFontSize 17
skinparam ClassStereotypeFontSize 15
skinparam NoteFontSize 16
skinparam LegendFontSize 15
skinparam titleFontSize 20
skinparam classAttributeIconSize 0
skinparam maxMessageSize 165
skinparam nodesep 18
skinparam ranksep 24
hide footbox
hide circle
title UC-4 · public retry acceptance
autonumber
participant "v1_lifecycle\nmedia.services" as V $MEDIA
database "Media DB" as MD $INFRA
[-> V : retry(session, owner_id, asset_id, key)\n[via media.api.v1_jobs.retry]
group Media transaction
 V -> MD : get_asset(..., lock=True); replay(...)
 alt existing RequestKey
  V -->[ : prior Asset → HTTP 202
 else absent / foreign / deleted asset or non-failed projection
  V -->[ : 404 / 409; no retry intent
 else eligible failed projection
  V -> MD : SQL: optional RequestKey + pinned source lookup
  V -> V : command(session, asset, "retry",\nmessage_id=stable_uuid, source=descriptor)
  V -> MD : SQL: stage MediaOutbox; COMMIT
  V -->[ : Asset → HTTP 202
 end
end
@enduml
