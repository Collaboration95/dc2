@startuml
!include _style.iuml
' Evidence (07c7c14): publisher/cli.py; publisher/client.py; publisher/state.py
skinparam dpi 180
skinparam BackgroundColor white
skinparam defaultFontSize 17
skinparam ArrowFontSize 16
skinparam ClassAttributeFontSize 16
skinparam ClassStereotypeFontSize 14
skinparam NoteFontSize 15
skinparam classAttributeIconSize 0
skinparam nodesep 22
skinparam ranksep 24
title UC-5 · analysis responsibilities
class "Publisher interface" as UI <<boundary>> {
 + publish(folder)
 + report(outcomes)
}
class "Batch publication" as C <<control>> {
 + submitEachFile(owner, folder)
 + retainUncertainIntent(intent)
}
class IntegrationBatch <<entity>> {
 + overallSuccess: Boolean
}
class PublicationIntent <<entity>> {
 + owner: Identifier
 + fileIdentity: Digest
 + requestKey: Identifier
}
class FileOutcome <<entity>> {
 + fileName: Text
 + acceptedAsset: Identifier [0..1]
 + error: Text [0..1]
}
UI ..> C
C ..> IntegrationBatch
C ..> PublicationIntent
IntegrationBatch "1" *-- "0..*" FileOutcome : attempted files
PublicationIntent "1" -- "0..1" FileOutcome : current attempt
@enduml
