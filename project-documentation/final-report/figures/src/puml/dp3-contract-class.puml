title DP-3 · shared wire types and public clients
class "Envelope" as E <<published language>> $INFRA {
 + schema_version: int
 + owner_id: str
 + source: Source | None
 + payload: dict
 {static} + from_dict(value: Any): Envelope
}
class "Source" as S <<published language>> $INFRA {
 ' selected fields
 + bucket: str
 + key: str
 + version_id: str
 + sha256: str
}
class "PublicJob" as J <<HTTP response>> $MEDIA {
 + id: UUID
 + output_url: str | None
 + hls_url: str | None
}
class "PublicClient" as P <<HTTP consumer>> $CLIENT {
 + upload(path, key)
 + status(job_id)
 + retry(job_id, key)
}
class "frontend/app.js" as F <<module>> $CLIENT {
 {static} + handleFile(file)
 {static} + followJob(scope, jobId,\n handlers)
 {static} + playbackSource(job)
}
E "0..*" -right-> "0..1" S : source
P ..up> J : HTTP\nschema
F ..up> J : HTTP\nschema
P -[hidden]right-> F
E -[hidden]down-> J
@enduml
