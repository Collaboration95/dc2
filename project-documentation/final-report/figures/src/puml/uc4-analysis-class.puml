@startuml
!include _style.iuml
' Adapted from reviewed presentation sources: W3-10/11/12/12a/13/13a; retry identity and independent stale fences
skinparam dpi 110
skinparam defaultFontSize 18
skinparam ArrowFontSize 17
skinparam ClassAttributeFontSize 17
skinparam ClassStereotypeFontSize 15
skinparam NoteFontSize 16
skinparam LegendFontSize 15
skinparam titleFontSize 20
skinparam classAttributeIconSize 0
skinparam maxMessageSize 165
skinparam nodesep 18
skinparam ranksep 24
hide footbox
hide circle
title UC-4 · conceptual retry and authority
class RetryAction <<boundary>> {
 + requestRetry()
}
class RetryControl <<control>> {
 + authorizeRetry()
 + createSuccessor()
}
class OwnedAsset <<entity>> {
 + source: SourceIdentity
}
class ProcessingJob <<entity>> {
 + status: JobState
}
class ProcessingAttempt <<entity>> {
 + number: Integer
 + authority: ExecutionAuthority
}
class RetryIdentity <<entity>> {
 + request: Identifier
}
RetryAction --> RetryControl
RetryControl ..> OwnedAsset : checks owner / stored source
RetryControl ..> ProcessingJob : serializes
OwnedAsset "1" -- "1" ProcessingJob
ProcessingJob "1" -- "1..*" ProcessingAttempt
ProcessingJob "1" -- "0..*" RetryIdentity
RetryIdentity "0..1" --> "1" ProcessingAttempt
legend bottom
One Job retains source identity while retries replace execution authority.
endlegend
@enduml
