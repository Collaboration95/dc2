@startuml
!include _style.iuml
skinparam defaultFontSize 16
skinparam ArrowFontSize 15
skinparam classAttributeFontSize 15
skinparam ClassStereotypeFontSize 13
skinparam NoteFontSize 14
skinparam titleFontSize 17
skinparam BoxPadding 8
skinparam maxMessageSize 400
skinparam nodesep 22
skinparam ranksep 22
skinparam sequenceMessageAlign left
hide footbox
hide circle
' scripts/aws/v1/release.py (promote, restore, abandon, _move); scripts/ci/cd.sh
title UC-7 design: restore after a failed candidate
autonumber
participant "cd.sh" as cd $INFRA
participant "release\n«module»" as rel $INFRA
participant "Journal" as j $INFRA
participant "hooks" as hk $INFRA
participant "Operator\nTransport" as aws $INFRA
cd -> rel : promote(...)
rel -> hk : public_smoke(...)
hk --> rel : not True
rel -> j : save(state): phase = restoring
rel --> cd : OperationError; intent retained
cd -> rel : restore(...)
rel -> j : locked(); read pending_release
rel -> hk : quiescent(owner)
rel -> j : save(state): phase = restoring
loop each prior function name
 rel -> aws : get-alias
 alt alias is neither prior nor candidate
  rel --> cd : OperationError: concurrent change
 else alias still on the candidate
  rel -> rel : _move(...): prior version
  rel -> aws : update-alias with RevisionId
  rel -> j : save(state)
 end
 rel -> aws : get-function: prior receipt unchanged
end
rel -> hk : public_smoke(prior versions)
rel -> aws : peer snapshot; schema read
rel -> hk : quiescent(owner)
alt restore checks pass
 rel -> j : save(state): restored receipt; clear pending_release
 rel --> cd : restored; schema_rollback = False
else a restore check fails
 rel --> cd : OperationError; intent remains
 opt nothing provably changed
  cd -> rel : abandon(...)
 end
 note over cd,j : If unchanged cannot be proved,\nretain intent: restore-failed.
end
@enduml
