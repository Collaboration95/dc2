!include _style.iuml
@startuml
skinparam BackgroundColor white
!include _style.iuml
' Adapted from reviewed W4 models; verified against current migration-head metadata.
title Processing database: jobs, attempts and command identity
hide circle
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontSize 18
skinparam ClassAttributeFontSize 17
skinparam ClassFontSize 19
skinparam ArrowFontSize 15
skinparam LegendFontSize 14
entity "jobs" as jobs $PROC {
  {field} * id : uuid <<PK>>
  {field} * asset_id : uuid <<UK>>
  {field} * owner_id : uuid
  {field} * status : varchar(16)
  {field} * current_attempt_id : uuid <<FK>>
  {field} * source : jsonb
  {field} * outputs : jsonb
  --
  {field} CHECK status IN ('queued',
  {field} 'processing', 'done', 'failed')
  {field} IX (owner_id)
}
entity "attempts" as attempts $PROC {
  {field} * id : uuid <<PK>>
  {field} * job_id : uuid <<FK,UK1>>
  {field} * attempt_number : integer <<UK1>>
  {field} * state : varchar(16)
  {field}   lease_token ? : uuid
  {field}   lease_expires_at ? : timestamptz
  {field}   deadline_at ? : timestamptz
  --
  UK1 = (job_id, attempt_number)
  --
  {field} CHECK attempt_number >= 1
  {field} CHECK state IN ('queued',
  {field} 'processing', 'succeeded',
  {field} 'failed', 'abandoned',
  {field} 'cancelled')
  {field} IX (state, next_dispatch_at)
}
entity "retry_requests" as retry_requests $PROC {
  {field} * id : uuid <<PK>>
  {field} * job_id : uuid <<FK,UK1>>
  {field} * request_id : uuid <<UK1>>
  {field} * attempt_id : uuid <<FK>>
  --
  UK1 = (job_id, request_id)
}
entity "submission_guards" as submission_guards $PROC {
  {field} * asset_id : uuid <<PK>>
  {field} * owner_id : uuid
  {field}   job_id ? : uuid <<FK>>
  {field}   deleted_at ? : timestamptz
}
jobs ||--o{ attempts : "job_id"
attempts ||--o{ jobs : "current_attempt_id (deferred)"
attempts ||--o{ retry_requests : "attempt_id / CASCADE"
jobs ||--o{ retry_requests : "job_id / CASCADE"
jobs |o--o{ submission_guards : "job_id"

legend bottom left
  * = NOT NULL; ? = nullable; PK = primary; FK = declared local foreign key
  UK = unique; UKn = one composite group; IX = explicit index
  Selected columns; dictionaries give all fields, defaults, predicates and index names.
endlegend
skinparam BackgroundColor white
@enduml
