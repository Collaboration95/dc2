top to bottom direction
component "lambda_handler / main\napi.uploads / v1_jobs / v1_hls\nauthorizer / api.deps" as API $MEDIA
component "services.direct_intake\nservices.v1_lifecycle / intake\nmedia.projections" as App $MEDIA
component "repositories.assets" as Repo <<Repository>> $MEDIA
component "models / upload_models\nprojection_models / messaging_models\ndatabase (owned Base)" as SQL $MEDIA
component "services.storage.Storage\nstorage_credentials" as Store <<Adapter>> $MEDIA
component "handlers / recovery_v1" as Ev $MEDIA
component "media.messaging" as Msg <<Transactional Outbox>> $MEDIA
component "delivery.sql / delivery.sqs.SQS\ncontracts.v1" as D $INFRA
interface "reserve / finalize\nedit / retry / tombstone\npublic_job / read_job" as IA
interface "verify_direct_upload\ncopy_output_source / sign_output" as IS
API ..> IA : requires
App -- IA
App ..> Repo : get_asset / replay
App ..> SQL : direct ORM
App ..> IS
Store -- IS
Repo ..> SQL
App ..> Msg : enqueue_submit / stage_command
Ev ..> Msg : publish_commands / consume_result
Ev ..> App : projection / cleanup
Msg ..> SQL : inbox / outbox
Msg ..> D : accept / stage / publish_due
legend bottom
Blue = Media; slate = shared library. Circle = provided exports; dashed arrow = dependency.
Repository = module lookup/replay role; Storage adapts Minio S3. Services also query ORM directly.
endlegend

