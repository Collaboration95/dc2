!include _style.iuml
@startuml
!include _style.iuml
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam classAttributeFontSize 18
skinparam ClassStereotypeFontSize 17
skinparam NoteFontSize 18
skinparam titleFontSize 21
skinparam BoxPadding 8
skinparam maxMessageSize 230
skinparam nodesep 22
skinparam ranksep 22
skinparam sequenceMessageAlign left
hide footbox
hide circle
'transformed from W2-launcher-control; conceptual responsibilities only
title UC-6 analysis: capacity authority
top to bottom direction
class "Capacity operations" as ops <<boundary>> {
 enable capacity
 disable capacity
 review outcome
}
class "Capacity controller" as ctl <<control>> {
 reconcile observations
 reserve available slots
 resolve uncertain starts
}
class "Demand" as demand <<entity>> {
 queued work
 visible work
}
class "Capacity policy" as policy <<entity>> {
 enabled state
 standard cap
 finite lifetime
}
class "Slot reservation" as slot <<entity>> {
 launch identity
 state
 deadline
}
class "Executor" as executor <<entity>> {
 observed identity
 execution state
 claimed work
}
ops --> ctl
ctl --> demand : reads
ctl --> policy : enforces
policy "1" -- "0..*" slot : governs
ctl --> slot : reserves / reconciles
slot "0..1" -- "0..1" executor : explained by
note bottom of slot
 A reservation is capacity authority.
 Work is claimed separately.
end note
@enduml
