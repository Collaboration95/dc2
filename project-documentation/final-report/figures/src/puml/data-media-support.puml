!include _style.iuml
@startuml
skinparam BackgroundColor white
!include _style.iuml
' Adapted from reviewed W4 models; verified against current migration-head metadata.
title Media database: request, cleanup and orphan authority
hide circle
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontSize 18
skinparam ClassAttributeFontSize 17
skinparam ClassFontSize 19
skinparam ArrowFontSize 15
skinparam LegendFontSize 14
entity "request_keys" as request_keys $MEDIA {
  {field} * owner_id : uuid <<PK,FK>>
  {field} * operation : varchar(20) <<PK>>
  {field} * request_key : uuid <<PK>>
  {field} * request_hash : varchar(64)
  {field} * asset_id : uuid <<FK>>
  {field} * created_at : timestamptz
}
entity "retry_intents" as retry_intents $MEDIA {
  {field} * id : uuid <<PK>>
  {field} * asset_id : uuid <<FK>>
  {field}   confirmed_at ? : timestamptz
  {field} * next_try_at : timestamptz
  --
  {field} IX (asset_id)
}
entity "cleanup_intents" as cleanup_intents $MEDIA {
  {field} * asset_id : uuid <<PK,FK>>
  {field}   processing_deleted_at ? : timestamptz
  {field}   source_deleted_at ? : timestamptz
  {field} * next_try_at : timestamptz
}
entity "staged_objects" as staged_objects $MEDIA {
  {field} * key : text <<PK>>
  {field} * created_at : timestamptz
  {field} * write_uncertain : boolean
}
entity "users\n<<reference: key only>>" as users $INFRA {
  {field} * id : uuid <<PK>>
}
entity "assets\n<<reference: key only>>" as assets $INFRA {
  {field} * id : uuid <<PK>>
}
assets ||--o| cleanup_intents : "asset_id"
assets ||--o{ request_keys : "asset_id"
users ||--o{ request_keys : "owner_id"
assets ||--o{ retry_intents : "asset_id"
staged_objects -[hidden]down- cleanup_intents
legend bottom left
  * = NOT NULL; ? = nullable; PK = primary; FK = declared local foreign key
  UK = unique; UKn = one composite group; IX = explicit index
  Selected columns; dictionaries give all fields, defaults, predicates and index names.
endlegend
skinparam BackgroundColor white
@enduml
