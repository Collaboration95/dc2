!include _style.iuml
@startuml
skinparam BackgroundColor white
!include _style.iuml
' Adapted from reviewed W4 models; verified against current migration-head metadata.
title Delivery schema: one independent copy in each database
hide circle
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontSize 18
skinparam ClassAttributeFontSize 17
skinparam ClassFontSize 19
skinparam ArrowFontSize 15
skinparam LegendFontSize 14
entity "message_inbox" as message_inbox $MEDIA {
  {field} * message_id : uuid <<PK>>
  {field} * body_hash : varchar(64)
  {field} * received_at : timestamptz
}
entity "message_outbox" as message_outbox $MEDIA {
  {field} * message_id : uuid <<PK>>
  {field} * body_hash : varchar(64)
  {field} * queue : varchar(40)
  {field} * body : jsonb
  {field} * next_try_at : timestamptz
  {field} * tries : integer
  {field}   claim_token ? : uuid
  {field}   sent_at ? : timestamptz
  {field}   last_error ? : varchar
  --
  {field} IX (next_try_at)
}
message_inbox -[hidden]right- message_outbox
legend bottom left
  * = NOT NULL; ? = nullable; PK = primary; FK = declared local foreign key
  UK = unique; UKn = one composite group; IX = explicit index
  Selected columns; dictionaries give all fields, defaults, predicates and index names.
endlegend
skinparam BackgroundColor white
@enduml
