{
  "openapi": "3.1.0",
  "info": {
    "title": "FlickPond Processing private API",
    "version": "1.0.0-design",
    "description": "Step 05 design specification, 9 October 2026. Not an implemented API. Baseline 8854537. Proposed behavior and compatibility changes are recorded in the design pack."
  },
  "servers": [
    {
      "url": "/internal/v1"
    }
  ],
  "security": [
    {
      "MediaServiceToken": []
    }
  ],
  "paths": {
    "/jobs": {
      "post": {
        "operationId": "submitJob",
        "summary": "Idempotent SubmitJob",
        "description": "Reserve/lock the owner-bound submission_guards row for asset_id before accepting. A deleted guard returns 410. Unique asset_id. Header owner, body owner and persisted owner must agree; other-owner access is 404. source.asset_id must equal asset_id. Canonical request fingerprint includes source revision/digest/type/size and ordered operations, but excludes source_url and URL expiry. Same key with a changed fingerprint is 409. Commit job/attempt before enqueue. If queue write fails after commit, return the durable queued job and reconcile delivery; never create another job.",
        "responses": {
          "201": {
            "description": "New durable job and queued attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingJob"
                }
              }
            }
          },
          "200": {
            "description": "Existing job for the same immutable request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingJob"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Valid caller lacks this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Previously accepted item is deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJob"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listJobs",
        "summary": "Owner-filtered batch GetJobs",
        "description": "Owner filter must run in the database query. No unscoped list operation. MM detects missing submitted jobs as a reconciliation discrepancy, not done or failed evidence.",
        "responses": {
          "200": {
            "description": "Only matching, nondeleted records. Missing requested assets are omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcessingJob"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          },
          {
            "name": "asset_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 200
            },
            "description": "Comma-separated requested asset UUIDs; batch aligns with the MM asset page.",
            "style": "form",
            "explode": false
          }
        ]
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Owner-filtered GetJob",
        "description": "",
        "responses": {
          "200": {
            "description": "Internal job plus durable output references.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingJob"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Internal Processing job UUID."
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          }
        ]
      }
    },
    "/assets/{asset_id}/job": {
      "delete": {
        "operationId": "cancelAssetJob",
        "summary": "Tombstone processing by stable Asset identity",
        "description": "MM always cancels by asset_id, including when a Submit response was lost. Submit and cancellation lock the same persistent submission_guards row. Cancel-first creates a tombstone that rejects later same-owner Submit with 410. Submit-first tombstones its job, cancels attempts and schedules output cleanup. Another owner is 404. Same-owner repeated cancellation is 204. Retain guards throughout the demo environment. No FK to MM.",
        "responses": {
          "204": {
            "description": "Owner-bound cancellation guard committed. Job cancellation and output cleanup intent commit when a job exists."
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Valid caller lacks this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": ""
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          }
        ]
      }
    },
    "/jobs/{job_id}/retry": {
      "post": {
        "operationId": "retryJob",
        "summary": "Idempotent RetryJob",
        "description": "First check the saved retry request under the owner. A replay returns the current job without a second transition, even if it has since finished. Otherwise lock the failed job, create one queued attempt and record retry_request_id in the same transaction. Nonfailed is 409. Enqueue after commit; reconcile queue failures.",
        "responses": {
          "202": {
            "description": "New queued attempt, or current job for a replayed retry_request_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingJob"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Valid caller lacks this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Previously accepted item is deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Internal Processing job UUID."
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MediaServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A high-entropy MM-to-Processing service secret from configuration. Distinct from user cookies and the reverse source-access token. Private network only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "loc",
                "msg",
                "type"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "detail"
        ],
        "additionalProperties": true
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "operator"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ],
        "additionalProperties": true
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "description": "Legacy name for the Media Management asset ID. Not the internal Processing job ID."
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": true
      },
      "PublicJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "failed"
            ]
          },
          "submission_status": {
            "type": "string",
            "enum": [
              "pending",
              "submitted",
              "error"
            ],
            "description": "Additive field. Pending is durable intake awaiting Processing."
          },
          "output_url": {
            "type": "string",
            "format": "uri"
          },
          "hls_url": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "status"
        ],
        "additionalProperties": true
      },
      "Source": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "asset_id",
          "revision",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "additionalProperties": false
      },
      "Output": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "hls_manifest"
            ]
          },
          "object_key": {
            "type": "string",
            "minLength": 1,
            "description": "Relative key under the configured output store. Never an arbitrary URL/bucket."
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "object_key",
          "media_type"
        ],
        "additionalProperties": true
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "failed",
              "abandoned",
              "cancelled"
            ]
          },
          "queued_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "number",
          "state",
          "queued_at"
        ],
        "additionalProperties": true
      },
      "ProcessingJob": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "failed"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "current_attempt": {
            "$ref": "#/components/schemas/Attempt"
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Output"
            }
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "job_id",
          "asset_id",
          "owner_id",
          "status",
          "source",
          "current_attempt",
          "outputs",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": true
      },
      "SourceAccess": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "source_url",
          "expires_at",
          "source"
        ],
        "additionalProperties": false
      },
      "EditOperation": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "clip"
              },
              "params": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "crop"
              },
              "params": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "w": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "downscale"
              },
              "params": {
                "type": "object",
                "properties": {
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "upscale"
              },
              "params": {
                "type": "object",
                "properties": {
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "convert"
              },
              "params": {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "mkv",
                      "mp3"
                    ]
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Also enforce unique operation names, end > start, no simultaneous up/downscale and source geometry checks in contract tests."
      },
      "EditRequest": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EditOperation"
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      },
      "SubmitJob": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
