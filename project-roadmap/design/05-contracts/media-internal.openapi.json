{
  "openapi": "3.1.0",
  "info": {
    "title": "FlickPond source access private API",
    "version": "1.0.0-design",
    "description": "Step 05 design specification, 9 October 2026. Not an implemented API. Baseline 8854537. Proposed behavior and compatibility changes are recorded in the design pack."
  },
  "servers": [
    {
      "url": "/internal/v1"
    }
  ],
  "security": [
    {
      "ProcessingServiceToken": []
    }
  ],
  "paths": {
    "/assets/{asset_id}/source-access": {
      "post": {
        "operationId": "refreshSourceAccess",
        "summary": "Issue a fresh source read capability",
        "description": "MM checks asset owner, immutable source revision and nondeleted state in its own DB. Revision mismatch is 409. It does not call Processing or read its database. Processing checks the active attempt before making the call. Never accept caller-supplied object keys, buckets or arbitrary URLs. A dependency failure gives 503, not a fabricated URL.",
        "responses": {
          "200": {
            "description": "Short-lived GET URL for one immutable source.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceAccess"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Valid caller lacks this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable. Do not report unconfirmed success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": ""
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Derived and set by Media Management after session/role authorisation. Processing compares it with persisted ownership. Never trust a public caller-supplied header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceAccessRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProcessingServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate Processing-to-MM source-grant secret. Limited to this capability API. Not interchangeable with the MM-to-Processing secret."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "loc",
                "msg",
                "type"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "detail"
        ],
        "additionalProperties": true
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "operator"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ],
        "additionalProperties": true
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "description": "Legacy name for the Media Management asset ID. Not the internal Processing job ID."
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": true
      },
      "PublicJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "failed"
            ]
          },
          "submission_status": {
            "type": "string",
            "enum": [
              "pending",
              "submitted",
              "error"
            ],
            "description": "Additive field. Pending is durable intake awaiting Processing."
          },
          "output_url": {
            "type": "string",
            "format": "uri"
          },
          "hls_url": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "status"
        ],
        "additionalProperties": true
      },
      "Source": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "asset_id",
          "revision",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "additionalProperties": false
      },
      "Output": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "hls_manifest"
            ]
          },
          "object_key": {
            "type": "string",
            "minLength": 1,
            "description": "Relative key under the configured output store. Never an arbitrary URL/bucket."
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "object_key",
          "media_type"
        ],
        "additionalProperties": true
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "failed",
              "abandoned",
              "cancelled"
            ]
          },
          "queued_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "number",
          "state",
          "queued_at"
        ],
        "additionalProperties": true
      },
      "ProcessingJob": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "failed"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "current_attempt": {
            "$ref": "#/components/schemas/Attempt"
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Output"
            }
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "job_id",
          "asset_id",
          "owner_id",
          "status",
          "source",
          "current_attempt",
          "outputs",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": true
      },
      "SourceAccess": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "source_url",
          "expires_at",
          "source"
        ],
        "additionalProperties": false
      },
      "EditOperation": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "clip"
              },
              "params": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "crop"
              },
              "params": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "w": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "downscale"
              },
              "params": {
                "type": "object",
                "properties": {
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "upscale"
              },
              "params": {
                "type": "object",
                "properties": {
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "convert"
              },
              "params": {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "mkv",
                      "mp3"
                    ]
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "params"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Also enforce unique operation names, end > start, no simultaneous up/downscale and source geometry checks in contract tests."
      },
      "EditRequest": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EditOperation"
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      },
      "SubmitJob": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_url_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EditOperation"
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "asset_id",
          "owner_id",
          "source",
          "source_url",
          "source_url_expires_at"
        ],
        "additionalProperties": false
      },
      "RetryRequest": {
        "type": "object",
        "properties": {
          "retry_request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "retry_request_id"
        ],
        "additionalProperties": false
      },
      "SourceAccessRequest": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "revision"
        ],
        "additionalProperties": false
      }
    }
  }
}
