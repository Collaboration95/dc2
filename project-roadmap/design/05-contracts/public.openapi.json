{
  "openapi": "3.1.0",
  "info": {
    "title": "FlickPond public facade",
    "version": "1.0.0-design",
    "description": "Step 05 design specification, 9 October 2026. Not an implemented API. Baseline 8854537. Proposed behavior and compatibility changes are recorded in the design pack."
  },
