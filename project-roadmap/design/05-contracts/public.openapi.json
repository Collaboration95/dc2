    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness only",
        "description": "",
        "responses": {
          "200": {
            "description": "Process is responsive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
